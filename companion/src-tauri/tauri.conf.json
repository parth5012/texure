{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "texure-companion",
  "version": "0.1.0",
  "identifier": "com.texure.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Texure Companion",
        "width": 960,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
