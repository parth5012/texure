{
  "schema_version": 1,
  "name": "gateway_error_propagation",
  "kind": "scenario",
  "description": "BB-R6 (spec 3R row 6): a bridge NODE_OUTDATED error is relayed through the tunnel unchanged (code, message, hint)",
  "tags": ["remote", "gateway", "write-first"],
  "steps": [
    {
      "action": "tunnel_connect",
      "args": {
        "endpoint": "wss://desktop.example/tunnel",
        "token": "valid-bearer-token"
      },
      "expect": { "connected": true }
    },
    {
      "action": "gateway_proxy",
      "args": {
        "rpc": "tap",
        "args": { "node": 3, "rev": 1 }
      },
      "expect": { "code": "NODE_OUTDATED", "relayed": true }
    }
  ],
  "assertions": [
    { "pred": "state", "target": "tunnel", "value": "CONNECTED" }
  ]
}
