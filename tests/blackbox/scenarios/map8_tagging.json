{
  "schema_version": 1,
  "name": "map8_tagging",
  "kind": "scenario",
  "description": "Dynamic view tagging: POST /tag surfaces tag as id",
  "steps": [
    {
      "action": "device_tree",
      "args": {},
      "expect": { "rev": "> 0" }
    },
    {
      "action": "tag",
      "args": { "index": 0, "rev": "$tree.rev", "tag": "my_custom_tag" },
      "expect": { "ok": true }
    },
    {
      "action": "device_tree",
      "args": {},
      "expect": { "rev": "> 0" }
    }
  ],
  "assertions": []
}
