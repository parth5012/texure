{
  "schema_version": 1,
  "name": "network_history",
  "kind": "scenario",
  "description": "BB-N2: Query /network/history to verify request payload assertion",
  "steps": [
    {
      "action": "network_request",
      "args": {
        "method": "POST",
        "url": "https://api.example.com/orders",
        "body": "{\"order_id\": \"ord-999\", \"amount\": 49.99}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "action": "network_history",
      "args": {
        "url_contains": "orders"
      },
      "expect": {
        "count": 1,
        "history.0.request_body": "{\"order_id\": \"ord-999\", \"amount\": 49.99}"
      }
    }
  ],
  "assertions": []
}
