{
  "schema_version": 1,
  "name": "cross_package_intent",
  "kind": "scenario",
  "description": "BB-D3: Verify cross-package intent rejection (Guardrail G6 check)",
  "steps": [
    {
      "action": "intent_dispatch",
      "args": {
        "action": "android.intent.action.VIEW",
        "uri": "https://external.example.com",
        "package": "com.external.app"
      },
      "expect": {
        "error.code": "CROSS_PACKAGE_FORBIDDEN"
      }
    }
  ],
  "assertions": []
}
